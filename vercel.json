{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/workspace",
      "destination": "/api/services?__route=workspace"
    },
    {
      "source": "/api/client",
      "destination": "/api/services?__route=client"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?action=cron-rank",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/admin?action=cron-tamper",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/admin?action=cron-review-reply&slot=0",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/admin?action=cron-review-reply&slot=1",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/admin?action=cron-review-reply&slot=2",
      "schedule": "15 2 * * *"
    },
    {
